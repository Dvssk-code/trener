# === YandexGPT (Foundation Models, Yandex Cloud) ===
# API-ключ сервисного аккаунта с доступом к Foundation Models
YANDEX_API_KEY=
# ID каталога Yandex Cloud (b1g...)
YANDEX_FOLDER_ID=

# === Приложение ===
# Публичный адрес приложения без слэша в конце (используется в ссылках QR-кодов)
BASE_URL=
# Порт для локального запуска (Render/Railway подставляют свои автоматически)
PORT=
# Пароль для кнопки «Сбросить урок» (POST /api/reset)
ADMIN_PASSWORD=
